# Root .env.example — copy to .env for local development
# Each service also has its own configs/<service>.env.example

# Postgres (single instance, all services share)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=secret

# MongoDB (single instance)
MONGODB_URI=mongodb://mongo_admin:secret@localhost:27017
MONGO_ADMIN_PASSWORD=secret

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9092
